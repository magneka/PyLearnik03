    "Allsorts_test_bulk_insert": {
        "prefix": "Allsorts_test_bulk_insert",
        "body": [
            "# Insert 1_000_000 records på 17 sekunder, 10 000 på 0.5s",
            "def test_bulk_insert(self):",
            "    self.allsorts_repo.create_table(execute=True)",
            "    ",
            "    data = []",
            "    records = 1_000",
            "    for i in range(records):            ",
            "        data.append((",
            "            None, ",
            "            self.uc_faker.get_random_fullname(),",
            "            random.randint(40, 99) * 10000, ",
            "            random.randint(0, 5), ",
            "            datetime.datetime(random.randint(1940, 2001), random.randint(1, 12), random.randint(1, 28))))",
            "     ",
            "    start_time = time.time()",
            "    self.allsorts_repo.begin_transaction()    ",
            "    self.allsorts_repo.bulk_insert(data)",
            "    self.allsorts_repo.commit_transaction()       ",
            "    end_time = time.time()",
            "    print(f\"Inserted {records} Elapsed time:\", end_time - start_time, \"seconds\")"
        ],
        "description": "Allsorts_test_bulk_insert"
