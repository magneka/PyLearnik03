            "    user=getenv(\"DOCKER_MSSQLUSER\"), ",
            "    password=getenv(\"DOCKER_MSSQLPW\"), ",
            "    database=getenv(\"DOCKER_MSSQLDB\"),",
            "    charset=\"ISO-8859-1\" # Fiks ØÆÅ problemer",
            "    )",
            "",
            "    conn.autocommit(True)",
            "    cursor = conn.cursor()",
            "    return cursor",
            "",
            "class Allsorts_query_tests(unittest.TestCase):",
            "    ",
            "    cursor = None",
            "    conn = None",
            "    allsorts_repo = None",
            "    uc_faker = None",
            "    ",
            "    def setUp(self):        ",
            "    self.cursor = get_cursor()        ",
            "    self.allsorts_repo = uc_repository3(Allsorts, self.cursor) ",
            "    self.uc_faker = UcFaker()",
            "        ",
            "    def tearDown(self):",
            "    #self.conn.rollback()",
            "    #self.conn.close()",
            "    pass            ",
            "    ",
            "    ",
            "if __name__ == '__main__':",
            "    unittest.main()"
        ],
        "description": "Allsorts_query_tests"
    },
