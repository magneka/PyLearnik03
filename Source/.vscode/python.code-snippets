			"def __init__(self, dataclass, cursor):",
			"    self.dataclass = dataclass",
			"    self.__cursor = cursor ",
			"    self._table_name = dataclass.__name__.upper()",
			"    self._fieldnames = [f.name for f in fields(dataclass)]",
