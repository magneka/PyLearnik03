            "from os import getenv",
            "import unittest",
            "import datetime",
            "import pymssql",
            "from dataclasses import dataclass, field",
            "from uc_repository3 import uc_repository3",
            "",
            "@dataclass(frozen=True, order=True)",
            "class Allsorts:",
            "    id: int",
            "    name: str",
            "    salary: float = field(default=800000)",
            "    children: int = field(default=0)",
            "    born: datetime.datetime = field(default=None)",
            "",
            "# Kopble oss mot en MSSQL database og returnere en cursor",
            "def get_cursor():",
            "    ",
            "    # Koble oss mot databasen med PyMSSQL via miljøvariabler",
            "    conn = pymssql.connect(",
            "        server=getenv(\"DOCKER_MSSQLSERVER\"), ",
            "        user=getenv(\"DOCKER_MSSQLUSER\"), ",
            "        password=getenv(\"DOCKER_MSSQLPW\"), ",
            "        database=getenv(\"DOCKER_MSSQLDB\"),",
            "        charset=\"ISO-8859-1\" # Fiks ØÆÅ problemer",
            "    )",
            "",
            "    conn.autocommit(True)",
            "    cursor = conn.cursor()",
            "    return cursor",
            "",
            "class Allsorts_sql_gen_test (unittest.TestCase):",
            "    ",
            "    cursor = None",
            "    conn = None",
            "    allsorts_repo = None",
            "    ",
            "    def setUp(self):        ",
            "        self.cursor = get_cursor()        ",
            "        self.allsorts_repo = uc_repository3(Allsorts, self.cursor)       ",
            "",
            "    def tearDown(self):",
            "        #self.conn.rollback()",
            "        pass",
            "    ",
            "                       ",
            "if __name__ == '__main__':",
            "    unittest.main()",
            "        "
        ],
        "description": "uc_rep_sql_test_"
    },
